{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AboveThem",
  "version": "0.1.0",
  "identifier": "co.goobentertainment.abovethem",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AboveThem",
        "label": "main",
        "width": 420,
        "height": 800,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": true,
        "transparent": false,
        "focus": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"]
  }
}
